{
  "name": "siec-dostepnosci-cyfrowej",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "lint:md": "markdownlint docs/**/*.md --config .markdownlint.json",
    "normalize-quotes": "node scripts/normalize-quotes.mjs",
    "validate": "node scripts/validate.mjs",
    "optimize-images": "svgo --recursive --config=svgo.config.mjs \"static/img/\" --output \"static/img/\" && node scripts/optimize-images.js",
    "postinstall": "node fixes/package-fixes.js",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "swizzle": "docusaurus swizzle",
    "typecheck": "tsc",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "dependencies": {
    "@barrierenlos/docusaurus-prerender-mermaid": "1.0.2",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "docusaurus-plugin-glossary": "3.4.0",
    "dotenv": "18.0.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/imagemin": "9.0.1",
    "@types/imagemin-mozjpeg": "8.0.4",
    "imagemin": "9.0.1",
    "imagemin-cli": "8.0.0",
    "imagemin-mozjpeg": "10.0.0",
    "imagemin-pngquant": "10.0.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "svgo": "4.1.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "rollup": "4.52.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
