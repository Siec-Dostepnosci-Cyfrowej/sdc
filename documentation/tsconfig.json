{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Ustawienia przepisane z @docusaurus/tsconfig@3.10.2, bez usuniętej w TypeScript 7 opcji "baseUrl".
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@site/*": ["./*"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
